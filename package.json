{
  "name": "agentor",
  "private": true,
  "description": "Harness de agentes para treinamento de estagiários, composto sobre o kernel Cordis do DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "setup:profile": "node scripts/setup-profile.mjs",
    "agentor": "node scripts/agentor.mjs",
    "dump-config": "node scripts/agentor.mjs --dump-config",
    "smoke": "node scripts/agentor.mjs --client exemplo --offline \"Como funciona o ponto eletrônico?\"",
    "avaliacao": "node scripts/avaliacao.mjs",
    "test": "node --test \"tests/unit/*.test.ts\" \"tests/e2e/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "node --test \"tests/e2e/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.2"
  },
  "devDependencies": {
    "@agentor/bundle-kernel": "workspace:*",
    "@agentor/bundle-training": "workspace:*",
    "@agentor/knowledge": "workspace:*",
    "@agentor/knowledge-fs": "workspace:*",
    "@agentor/llm-offline": "workspace:*",
    "@agentor/tool-knowledge": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
